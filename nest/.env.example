# ========== 后端环境变量（复制为 .env 后按需修改） ==========

# ---------- 数据库（必填） ----------
DATABASE_URL="mysql://root:password@127.0.0.1:3306/laoma_jiadian"

# ---------- JWT 认证 ----------
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ---------- 服务 ----------
NODE_ENV="development"
PORT=3721

# ---------- CORS ----------
# 逗号分隔白名单，未配置时允许所有来源（仅开发用）
# CORS_ORIGIN="https://laoma.snrthn.com"

# ---------- 日志 ----------
LOG_LEVEL="info"

# ---------- 文件上传 ----------
UPLOAD_DIR="uploads"

# ---------- Sentry 错误追踪（可选） ----------
# SENTRY_DSN="https://xxx@sentry.io/xxx"
SENTRY_TRACES_SAMPLE_RATE=0.2

# ---------- 自动派单 ----------
AUTO_DISPATCH_ENABLED=true
AUTO_DISPATCH_TIMEOUT_MS=1800000
AUTO_DISPATCH_SCAN_MS=60000
SLA_SCAN_MS=300000

# ---------- 商户支付配置 ----------
MERCHANT_ENC_KEY="change-me-in-production"
MERCHANT_CONFIG_PATH="config/merchant.json"

# ---------- 支付宝 ----------
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL=""

# ---------- 微信支付 ----------
WX_MCH_SERIAL=""
WX_NOTIFY_URL=""

# ---------- 短信 ----------
SMS_SECRET_ENCRYPT_KEY=""
