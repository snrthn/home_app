# ─── 数据库 ───────────────────────────────────────────────
# MySQL 8.0，开发库 laoma_jiadian。有密码改为 mysql://root:密码@127.0.0.1:3306/laoma_jiadian
DATABASE_URL="mysql://root@127.0.0.1:3306/laoma_jiadian?connection_limit=10"

# ─── JWT 认证 ─────────────────────────────────────────────
JWT_ACCESS_SECRET="laoma-dev-access-secret-change-me"
JWT_REFRESH_SECRET="laoma-dev-refresh-secret-change-me"
JWT_ACCESS_TTL="3600"
JWT_REFRESH_TTL="604800"

# ─── 服务端口 ─────────────────────────────────────────────
# 开发环境后端 3721（三七二十一），前端 3824（三八二十四）—— 九九乘法表记忆法
PORT="3721"

# ─── 文件上传 ─────────────────────────────────────────────
UPLOAD_DIR="./uploads"

# ─── 日志 ─────────────────────────────────────────────────
# Pino 日志级别：trace/debug/info/warn/error/fatal，开发用 debug，生产用 info
LOG_LEVEL="info"

# ─── CORS ─────────────────────────────────────────────────
# 逗号分隔白名单，如 https://example.com,https://www.example.com
# 不配置时回落 true（开发态跨端口兼容），生产必须设白名单
# CORS_ORIGIN=""

# ─── 短信加密 ─────────────────────────────────────────────
# 32 字节 hex 或 base64，用于加密 AccessKeySecret。不配置则明文存储（仅本地可接受）
# 生产环境务必配置：openssl rand -hex 32
# SMS_SECRET_ENCRYPT_KEY=""

# ─── 自动派单 ─────────────────────────────────────────────
# 关闭设为 false，默认开启
# AUTO_DISPATCH_ENABLED="true"
# 派单超时（毫秒），默认 30 分钟
# AUTO_DISPATCH_TIMEOUT_MS="1800000"
# 派单扫描间隔（毫秒），默认 60 秒
# AUTO_DISPATCH_SCAN_MS="60000"

# ─── SLA 超时扫描 ─────────────────────────────────────────
# 工单 SLA 扫描间隔（毫秒），默认 5 分钟
# SLA_SCAN_MS="300000"

# ─── 支付配置 ─────────────────────────────────────────────
# 商户配置加密密钥，不配置时降级为开发默认值（生产必须配置）
# MERCHANT_ENC_KEY=""
# 商户配置文件路径，默认项目根 config/merchant.json
# MERCHANT_CONFIG_PATH=""
# 支付宝网关地址，默认沙箱地址
# ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
# 支付宝回调地址（生产环境配置）
# ALIPAY_NOTIFY_URL=""
# 微信商户证书序列号
# WX_MCH_SERIAL=""
# 微信回调地址（生产环境配置）
# WX_NOTIFY_URL=""
