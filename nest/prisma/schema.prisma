// 老马家电 — Prisma schema (MySQL)
// 对应 plan.md v0.4 库表设计。MVP 范围：单城市、单租户、一单一师傅。
//
// 2026-08-06 重构（方案 B）：
// - User 拆为「账号核心 User」+「资料画像 UserProfile」(1:1)。
//   User 只放登录/安全/审计类字段；昵称/头像/实名/性别/生日/城市/会员/积分/余额/信用分等放 UserProfile。
// - Master 维持独立 1:1 扩展（师傅专属：idCard/skills/rating/orderCount/服务城市/审核状态）。
// - 全部表增加 deletedAt(DateTime?) 支持逻辑删除（软删除）。

generator client {
  provider   = "prisma-client-js"
  // pnpm 的 @prisma/client 是只读软链，无法直接生成进 store；
  // 显式输出到项目可写的 node_modules/.prisma/client，并在代码中从此路径导入。
  output      = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  master
  customer
}

enum OrderStatus {
  pending_payment
  pending_accept
  accepted
  departing
  arrived
  servicing
  pending_confirm
  reviewed
  evaluated
  refunding
  refunded
  cancelled
  paid
}

enum PaymentStatus {
  pending
  paid
  confirmed
  refunded
}

enum SettlementStatus {
  pending    // 待入账（退款补偿单：需管理端审核确认后才入账）
  credited   // 已入账（常规单：验收即时自动入账；补偿单：管理端确认后入账）
  rejected   // 已驳回（补偿单被管理端否决，不入账）
}

enum SettlementType {
  normal        // 常规结算单（订单验收后自动生成，即时入账）
  compensation  // 退款补偿单（阶梯退款时师傅应得部分，管理端审核后入账）
}

enum MasterStatus {
  pending
  active
  disabled
}

// ---------------- 账号核心（登录 / 安全 / 审计） ----------------
model User {
  id            String   @id @default(cuid())
  role          Role
  phone         String   @unique
  passwordHash  String?
  email         String?
  status        String   @default("active") // active | disabled | frozen（暂用 String，后期可升枚举）

  // 逻辑删除
  deletedAt     DateTime?

  // 账号安全：改密/后台强制下线时 +1，JWT 校验比对使旧 token 失效
  tokenVersion  Int      @default(0)

  // 登录审计
  lastLoginTime DateTime?
  lastLoginIp   String?  @db.Text
  loginCount    Int      @default(0)
  lastActiveAt  DateTime?

  // 验证状态
  phoneVerified Boolean  @default(true)
  emailVerified Boolean  @default(false)

  // 来源 / 邀请 / 跨端身份
  registerSource String?   @db.Text // wechat | code | invite | admin
  invitedBy     String?    @db.Text // 邀请人 userId（自关联，业务层校验）
  inviteCode    String?    @db.Text // 自己的邀请码
  wechatOpenid  String?    @db.Text // 微信 OAuth（不强唯一：同一微信可同时是客户/师傅）
  wechatUnionid String?    @db.Text
  tenantId      String?    @db.Text // 多租户预留（MVP 单租户留空）

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile        UserProfile?
  master         Master?
  customerOrders Order[]     @relation("CustomerOrders")
  addresses      Address[]
  payments       Payment[]
  reviews        Review[]
  ticketsAsCustomer Ticket[] @relation("TicketCustomer")
  ticketsAsAssignee  Ticket[] @relation("TicketAssignee")
  ticketComments     TicketComment[] @relation("TicketCommentOperator")
  refundsRequested   Refund[] @relation("RefundRequestedBy")
  refundsReviewed    Refund[] @relation("RefundReviewedBy")

  // 管理端 RBAC：单角色，一个后台账号(role=admin)绑一个岗位角色；role≠admin 时恒为空
  staffRoleId String?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id])

  @@map("user")
}

// ---------------- 资料画像（展示 / 业务扩展，1:1） ----------------
model UserProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname      String?
  avatar        String?
  realName      String?  // 客户实名/发票；师傅实名仍存 Master.realName
  gender        String?
  birthday      DateTime?
  // 用户所在地：省/市/区 + 行政编码。不使用单一 city 字段，统一为 6 段结构。
  province      String?
  provinceCode  String?
  city          String?  // 市名称（6 段之一）
  cityCode      String?
  district      String?
  districtCode  String?
  vipLevel      Int      @default(0)
  points        Int      @default(0)
  balance       Decimal  @db.Decimal(10, 2) @default(0)
  creditScore   Int      @default(100)
  // 个人描述（自我介绍）：客户 / 师傅 / 管理员三端通用，在个人中心最后一行维护。
  bio           String?  @db.Text
  notifySettings Json?   // 推送偏好（短信/微信/邮件开关）
  tags          Json?    // 运营标签（VIP/高频/风险）
  remark        String?  // 后台备注
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deletedAt     DateTime?

  @@map("userprofile")
}

// ---------------- 师傅扩展（1:1，师傅专属） ----------------
model Master {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id])
  realName    String
  idCard      String?
  // 师傅服务区域：省/市/区 + 行政编码。不使用单一 city 字段，统一为 6 段结构。
  province      String?
  provinceCode  String?
  city          String?  // 市名称（原 city 字段，改为可空并纳入 6 段结构）
  cityCode      String?
  district      String?
  districtCode  String?
  // 接单范围：多值区域集合，基于 ServiceArea 已开通节点，支持省/市/区部分粒度（缺级通配）。
  serviceAreas Json?
  skills      Json?
  idVerified  Boolean      @default(false)
  rating      Decimal      @db.Decimal(3, 2) @default(5.0)
  orderCount  Int          @default(0)
  status       MasterStatus @default(pending)
  rejectReason String?      @db.Text // 认证审核拒绝理由（仅在 status=disabled 时有意义）
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  deletedAt   DateTime?

  orders       Order[]
  payments     Payment[]
  reviews      Review[]
  settlements  Settlement[]
  withdrawals  Withdrawal[]
  quotations   Quotation[]
  tickets      Ticket[]

  @@map("master")
}

model ServiceCategory {
  id          String   @id @default(cuid())
  parentId    String?
  parent      ServiceCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  level       Int      @default(1)
  name        String
  icon        String?
  sort        Int      @default(0)
  isActive    Boolean  @default(true)
  description String?   @db.Text
  items       ServiceItem[]
  children    ServiceCategory[] @relation("CategoryTree")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("servicecategory")
}

model ServiceItem {
  id              String      @id @default(cuid())
  categoryId      String
  category        ServiceCategory @relation(fields: [categoryId], references: [id])
  name            String
  price           Decimal     @db.Decimal(10, 2)
  unit            String?
  description     String?   @db.Text
  coverImage      String?   @db.Text
  estimatedDuration Int?      // 预计服务时长（分钟），派单排期参考
  sort            Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  deletedAt       DateTime?

  orders Order[]

  @@map("serviceitem")
}

// ---------------- 服务区域（平台开通城市字典，2026-08-12 新增） ----------------
// 平台已开通的行政区域节点表，支持省/市/区三级自由配置（树形勾选开通）。
// 是 ServiceItem.区域 / Master.服务区域 的上游白名单（本期仅管理字典，联动校验留待下一阶段）。
// 6 段式冗余存全路径，便于按省/市维度查询；code 为 6 位行政编码，parentCode 指向上级节点。
model ServiceArea {
  id           String   @id @default(cuid())
  level        Int      // 1=省 2=市 3=区
  name         String   // 节点名称（如「北京市」「朝阳区」）
  code         String   // 6 位行政编码（唯一业务键）
  parentCode   String?  // 上级节点 code（省级为 null）

  // 6 段式冗余全路径，便于按省/市查询（与 UserProfile/Master/ServiceItem 对齐）
  province      String?
  provinceCode  String?
  city          String?
  cityCode      String?
  district      String?
  districtCode  String?

  isActive     Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deletedAt    DateTime?

  @@unique([code])
  @@index([level])
  @@index([parentCode])
  @@index([provinceCode])

  @@map("servicearea")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  contactName  String
  contactPhone String
  province     String?
  provinceCode String?  @db.VarChar(12)
  city         String
  cityCode     String?  @db.VarChar(12)
  district     String?
  districtCode String?  @db.VarChar(12)
  detail       String
  tag          String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  deletedAt    DateTime?

  orders Order[]

  @@map("address")
}

model Order {
  id               String      @id @default(cuid())
  orderNo          String      @unique
  customerId       String
  customer         User        @relation("CustomerOrders", fields: [customerId], references: [id])
  masterId         String?
  master           Master?     @relation(fields: [masterId], references: [id])
  addressId        String
  address          Address     @relation(fields: [addressId], references: [id])
  serviceItemId    String
  serviceItem      ServiceItem @relation(fields: [serviceItemId], references: [id])
  serviceSnapshot  Json
  // 分账规则快照（下单时按 服务项→类目树→全局 解析后固化，退款/结算全程读它，
  // 与「当下配置」解耦：后期改类目佣金不会污染历史单）。结构见 CommissionRule 注释。
  commissionSnapshot Json?
  city             String
  amount           Decimal     @db.Decimal(10, 2)
  appointmentDate  DateTime?
  appointmentSlot  String?
  status           OrderStatus @default(pending_accept)
  arriveCode       String?     // 到达验证码（客户生成，师傅输入校验后确认到达）
  remark           String?
  cancelReason     String?     @db.VarChar(200)  // 取消原因（取消时必填，三端订单信息卡展示）
  customerPhotos   Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  deletedAt        DateTime?

  logs        OrderLog[]
  payments    Payment[]
  quotations  Quotation[]
  settlement  Settlement?
  review      Review?
  tickets     Ticket[]
  refunds     Refund[]

  @@map("order")
}

model OrderLog {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id])
  action     String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  operatorId String?
  photos     Json?
  note       String?
  createdAt  DateTime    @default(now())

  deletedAt  DateTime?

  @@map("orderlog")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id])
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  masterId    String?
  master      Master?       @relation(fields: [masterId], references: [id])
  qrType      String // wechat | alipay
  proofUrl    String?
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(pending)
  confirmedBy String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  deletedAt   DateTime?

  @@map("payment")
}

model Quotation {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  masterId    String
  master      Master   @relation(fields: [masterId], references: [id])
  laborFee    Decimal? @db.Decimal(10, 2)
  partsFee    Decimal? @db.Decimal(10, 2)
  total       Decimal? @db.Decimal(10, 2)
  partsDetail Json?
  status      String?
  createdAt   DateTime @default(now())

  deletedAt   DateTime?

  @@map("quotation")
}

model Settlement {
  id           String           @id @default(cuid())
  orderId      String           @unique
  order        Order            @relation(fields: [orderId], references: [id])
  masterId     String
  master       Master           @relation(fields: [masterId], references: [id])
  orderAmount  Decimal          @db.Decimal(10, 2)
  platformFee  Decimal          @db.Decimal(10, 2) @default(0)
  masterAmount Decimal          @db.Decimal(10, 2)
  type         SettlementType   @default(normal)
  status       SettlementStatus @default(credited)
  settledAt    DateTime?        // 入账时间（credited 时写入）
  note         String?
  reviewedBy   String?          // 审核操作人 userId（补偿单确认入账/驳回时写入，供台账与订单详情展示）
  reviewedAt   DateTime?        // 审核时间
  createdAt    DateTime         @default(now())

  deletedAt    DateTime?

  refund       Refund?          // 反向：该结算单由哪个退款单审核通过后生成（1:1）

  @@map("settlement")
}

// ---------------- 分账规则配置（2026-08-19 新增） ----------------
// 两条正交配置轴 × 三级降级 + 订单快照：
//   轴1 分账比例 platformRate（平台抽佣率，师傅得 1-rate）
//   轴2 退款佣金策略 refundPolicy + refundTiers（异常场景钱怎么分）
// 解析优先级（越具体越优先）：service 覆盖 → category（沿 parentId 向上找最近命中）→ global 兜底。
// 订单创建时解析结果固化进 Order.commissionSnapshot，退款/结算只读快照，不读实时配置。
enum CommissionScope {
  global   // 平台全局默认（refId 恒为空串）
  category // 按服务类目覆盖（refId = ServiceCategory.id，支持树形向上继承）
  service  // 按服务项覆盖（refId = ServiceItem.id，最高优先级）
}

enum RefundPolicy {
  full            // 全额退款：忽略阶梯，退用户 100%，平台与师傅均不留成
  tiered          // 阶梯退款（默认）：按 refundTiers 留成，留成再按 platformRate 拆平台/师傅
  keep_commission // 佣金不退：在阶梯基础上，平台佣金部分始终不退给用户
}

model CommissionRule {
  id           String          @id @default(cuid())
  scope        CommissionScope
  // 作用对象 id：global 为空串（MySQL 下 NULL 不参与唯一约束，故用空串保证 global 唯一）
  refId        String          @default("")
  // 平台抽佣率 0~1（0.1000 = 10%），师傅得 1 - platformRate
  platformRate Decimal         @db.Decimal(5, 4) @default(0)
  refundPolicy RefundPolicy    @default(tiered)
  // 阶梯退款比例：{ "departing": 0.8, "arrived": 0.5 }（键为订单状态，缺省状态退全额）
  refundTiers  Json?
  isActive     Boolean         @default(true)
  note         String?         @db.VarChar(200)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  deletedAt    DateTime?

  @@unique([scope, refId])
  @@index([scope, isActive])

  @@map("commissionrule")
}

// ---------------- 师傅提现（2026-08-18 新增） ----------------
// 余额实时聚合（Σ credited settlements.masterAmount − Σ paid withdrawals − Σ pending withdrawals），
// 不落冗余余额字段。申请即冻结（pending 计入已占用），管理端审核打款：通过→线下打款→标记 paid；驳回→解冻。
enum WithdrawalChannel {
  wechat
  alipay
  bank
}

enum WithdrawalStatus {
  pending   // 待审核（金额已冻结，计入余额扣减）
  paid      // 已打款（管理端线下打款完成后标记）
  rejected  // 已驳回（解冻退回余额）
}

model Withdrawal {
  id         String            @id @default(cuid())
  masterId   String
  master     Master            @relation(fields: [masterId], references: [id])
  amount     Decimal           @db.Decimal(10, 2)
  channel    WithdrawalChannel
  account    String            @db.Text // 收款账号快照（微信号/支付宝账号/银行卡号，展示时脱敏）
  status     WithdrawalStatus  @default(pending)
  reviewNote String?           @db.VarChar(200) // 审核备注（驳回时必填原因）
  reviewedBy String? // 审核操作人 userId
  paidAt     DateTime? // 打款完成时间
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  deletedAt    DateTime?

  @@index([masterId, status])
  @@index([status, createdAt])

  @@map("withdrawal")
}

model Review {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  customerId  String
  customer    User     @relation(fields: [customerId], references: [id])
  masterId    String
  master      Master   @relation(fields: [masterId], references: [id])
  rating      Int
  comment     String?
  anonymous   Boolean  @default(false)
  createdAt   DateTime @default(now())

  deletedAt   DateTime?

  tickets     Ticket[]

  @@map("review")
}

model PaymentQr {
  id        String   @id @default(cuid())
  type      String // wechat | alipay
  imageUrl  String
  updatedBy String?
  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@map("paymentqr")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String?
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  deletedAt DateTime?

  @@map("notification")
}

// ---------------- 协议管理（注册协议 / 隐私政策，多端多版本） ----------------
enum AgreementScope {
  customer
  master
  admin
}

enum AgreementType {
  registration
  privacy
}

enum AgreementStatus {
  draft
  published
  offline
}

// 协议类型/模板：代表「某端 + 某类型」这一个逻辑协议（如 客户端注册协议）
model AgreementTemplate {
  id       String          @id @default(cuid())
  scope    AgreementScope
  type     AgreementType
  code     String          @unique // 稳定唯一键，如 customer-registration / master-privacy
  title    String
  versions AgreementVersion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([scope, type])

  @@map("agreementtemplate")
}

// 协议版本：每次新建=一条记录，版本号按模板内 max+1 自增（只增不减）
model AgreementVersion {
  id          String          @id @default(cuid())
  templateId  String
  template    AgreementTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int // 按模板 max(version)+1 自增
  title       String
  contentHtml String?         @db.Text // 富文本 HTML（存储前经 DOMPurify 清洗）
  status      AgreementStatus @default(draft)
  isCurrent   Boolean         @default(false) // 当前生效版本（同模板仅一条为 true）
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([templateId])
  @@index([isCurrent])

  @@map("agreementversion")
}

// 公告通知：运营端编辑发布的广播（活动/规则/维护/节假日等），按端投放。
// 单表、无版本（一次性发布物）；status 控制草稿/已发布/已下线；pinned 置顶优先；
// startAt/endAt 为可选生效时间窗（null 表示立即/长期）。
model Notice {
  id          String    @id @default(cuid())
  scope       String // 'customer' | 'master' | 'admin' —— 投放端
  title       String
  summary     String? // 列表/摘要展示
  contentHtml String    @db.Text // 富文本正文（存储前经 DOMPurify 清洗）
  status      String    @default("draft") // 'draft' | 'published' | 'offline'
  pinned      Boolean   @default(false) // 置顶优先
  startAt     DateTime? // 生效开始（null=立即）
  endAt       DateTime? // 生效结束（null=长期）
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  targetRegions Json? // 通知范围：数组，每项 {provinceCode?,cityCode?,districtCode?}，缺级=通配；空=全平台可见

  @@index([scope, status])

  @@map("notice")
}

// 站点内容（运营可维护的静态文案 / 富文本）：关于我们等。
// 按 key 唯一存取（如 about_customer / about_master / about_admin）；无版本，直接覆盖更新。
model SiteContent {
  id          Int      @id @default(autoincrement())
  key         String   @unique // 稳定唯一键，如 about_customer / about_master / about_admin
  title       String   @default("")
  contentHtml String   @db.Text // 富文本 HTML（展示层经 DOMPurify 清洗）
  updatedAt   DateTime @updatedAt

  @@index([key])

  @@map("sitecontent")
}

// ---------------- 全局配置（单例，运营端系统设置，2026-08-17 新增） ----------------
// 单例表：固定 id=1，GET 时若不存在则 upsert 默认行。
// 聚合系统基础信息与视觉主题：系统名称、Logo、主题主色、客服电话（在线客服拨号来源）。
// 字段保持精简，不为凑指标引入无意义参数。
model SystemConfig {
  id                   Int      @id @default(1)
  siteName             String   @default("老马家电")
  logoUrl              String?  // 站点 Logo（选填，留空用默认）
  primaryColor         String?  // 主题主色（hex），前端动态推导整套品牌色
  customerServicePhone String?  // 客服热线，用户端「在线客服」拨号来源
  // 短信验证码模式：mock=开发/演示（验证码随响应回传前端 Toast 提示）；real=真实调用阿里云短信网关下发
  smsMode              String   @default("mock")
  // 阿里云短信网关参数（仅 real 模式生效；缺失时发码接口返回明确错误提示）
  smsAccessKeyId       String?
  smsAccessKeySecret   String?
  smsSignName          String?
  smsTemplateCode      String?
  // Sentry DSN：运营平台配置后前端自动初始化错误监控；留空=关闭监控
  sentryDsn            String?
  updatedAt            DateTime @updatedAt

  @@map("systemconfig")
}

// 商户支付配置：替代原 JSON 文件存储，敏感字段加密后存 DB
model MerchantConfig {
  id          Int      @id @default(1)
  provider    String   @default("mock") // mock | wechat | alipay
  enabled     Boolean  @default(false) // 真实通道是否启用（false=全局走 mock）
  appId       String?
  mchId       String?
  // 敏感字段：加密存储，绝不返回给前端明文
  appSecret   String?
  apiKey      String?
  certContent String?
  remark      String?
  updatedAt   DateTime @updatedAt

  @@map("merchantconfig")
}

// ---------------- 管理端 RBAC（角色权限，2026-08-11 新增，对应 docs/rbac-design.md） ----------------
// 设计要点：权限定义放 DB（运行时可改角色不碰代码）；功能点(菜单/按钮/接口)走代码注册表，不在此建表。
// 两层角色分离：① 账号类型 Role 枚举(admin/master/customer) 仅作入口闸门；② 内部岗位角色 StaffRole 决定管理端内能干什么。

// 岗位角色：预设 7 个（super_admin 为系统角色，不可删/不可改权限）
model StaffRole {
  id          String   @id @default(cuid())
  key         String   @unique // 'super_admin' | 'ops_lead' | 'cs_agent' | 'finance' | 'auditor' | 'editor' | 'dispatcher'
  name        String // 中文显示名，如 '超级管理员'
  description String?
  isSystem    Boolean  @default(false) // 系统角色不可删、不可改权限
  users       User[] // 单角色：一个后台账号绑一个岗位角色
  permissions StaffRolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt   DateTime?

  @@map("staffrole")
}

// 权限：抽象权 resource:action（如 orders:refund）。粒度适中，不按页面、也不按每个按钮。
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // 'orders:refund'
  name        String // '订单退款'
  resource    String // 'orders'
  action      String // 'refund'
  group       String // 分组（管理页展示用，如 '订单管理'）
  description String?
  roles       StaffRolePermission[]
  createdAt   DateTime @default(now())

  @@index([group])

  @@map("permission")
}

// 角色-权限 多对多中间表（取代用户-多角色，初期单角色即可满足）
model StaffRolePermission {
  roleId       String
  permissionId String
  role         StaffRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])

  @@map("staffrolepermission")
}

// ---------------- 管理端操作审计日志（P5 收口，2026-08-11 新增） ----------------
// 记录管理端高风险写操作（账号/角色/服务/订单/内容等），供「操作日志」页审计追溯。
// 由后端 AuditInterceptor 在 @Audit 标记的接口执行后自动落库；权限码 logs:view 控制可见性。
model OperationLog {
  id           String    @id @default(cuid())
  userId       String? // 操作者 id（AuthUser.sub）
  username     String? // 操作者账号/手机号
  staffRoleKey String? // 操作者内部岗位角色 key
  action       String // 动作码，如 'users:admin_create' / 'rbac:role_update'
  module       String // 模块：users / masters / services / orders / content / rbac ...
  resourceId   String? // 被操作资源 id（用户/订单/角色 ...）
  detail       Json? // 操作参数摘要（脱敏后）
  ip           String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([userId])
  @@index([action])

  @@map("operationlog")
}

// ---------------- 工单 / 投诉（2026-08-20 新增，详见 docs/complaints-tickets-design.md） ----------------
// 架构：工单底座 + 投诉挂件。Ticket 为统一流转载体，type=complaint 时挂 1:1 Complaint。
// 处理结果四选一复用现有资产：refund 走 orders.transition 阶梯退款 + compensation 结算单；
// compensate 走 Settlement(type=compensation)；redispatch 仅记录人工线下安排；no_fault 直接关闭。

enum TicketType {
  consult    // 咨询
  complaint  // 投诉（挂件）
  refund     // 退款申请
  report     // 举报
  system     // 系统异常
}

enum TicketStatus {
  open        // 待受理
  processing  // 受理中
  pendingUser // 待用户确认方案
  resolved    // 已解决
  rejected    // 已驳回（投诉不成立）
  closed      // 已关闭
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum ComplaintReason {
  attitude // 服务态度
  quality  // 技术质量
  fee     // 乱收费
  late    // 迟到爽约
  damage   // 损坏物品（强制 urgent）
  other
}

enum ComplaintResult {
  refund      // 退款（走 orders.transition 阶梯退款）
  compensate   // 补偿（平台承担，Settlement.compensation）
  redispatch   // 重新服务（仅记录，人工线下安排，不自动建单）
  no_fault     // 无责关闭
}

model Ticket {
  id            String        @id @default(cuid())
  ticketNo      String        @unique            // GT + yyyyMMdd + 4位序列，如 GT202608200001
  type          TicketType
  source        String                             // client | master | admin | system
  title         String        @db.VarChar(100)
  content       String        @db.Text
  images        Json?                             // 客户上传凭证（数组）
  status        TicketStatus  @default(open)
  priority      TicketPriority @default(normal)

  // 关联三主体（均可空，系统类工单无关联）
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
  reviewId      String?                            // 评价后引导投诉时关联
  review        Review?        @relation(fields: [reviewId], references: [id])
  customerId    String?                           // 提交人（客户）
  customer      User?          @relation("TicketCustomer", fields: [customerId], references: [id])
  masterId      String?                           // 被投诉/相关师傅
  master        Master?        @relation(fields: [masterId], references: [id])

  assigneeId    String?                           // 受理客服 userId（cs_agent）
  assignee      User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])

  // SLA 与自动升级（docs 第 4 节）
  firstResponseDeadline DateTime?
  resolveDeadline       DateTime?
  escalatedFirstResponse Boolean @default(false)  // 首响是否已升级（防重复）
  escalatedResolve       Boolean @default(false)  // 处理是否已升级
  escalationLevel        Int    @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  closedAt      DateTime?

  deletedAt     DateTime?

  complaint      Complaint?
  comments       TicketComment[]
  refunds        Refund[]

  @@index([status, priority])
  @@index([assigneeId, status])
  @@index([orderId])
  @@index([customerId])
  @@index([masterId])

  @@map("ticket")
}

model Complaint {
  ticketId            String          @id                 // 1:1，复用 Ticket.id
  ticket              Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  againstMasterId     String?                             // 被投诉师傅
  reason              ComplaintReason
  expectation         String?                            // 用户期望：退款/重做/赔偿
  result              ComplaintResult?                   // resolved 时必填
  handledById         String?                            // 处置人 userId
  refundSettlementId  String?                            // 关联 compensation 结算单（result=refund/compensate 时）
  handledAt           DateTime?
  createdAt           DateTime        @default(now())

  @@map("complaint")
}

// 退款单（2026-08-21 新增，详见 docs/refund-aftersale-design.md）
// 审核流：投诉处置 result=refund 时仅创建申请（pending_review），运营在管理端「退款/售后」
// （/admin/orders/refund）审核通过（approved，立即执行阶梯退款）或驳回（rejected）。
// 取消单自动退 / 客户端手动退仍走直退，不建单。
enum RefundStatus {
  pending_review // 待审核
  approved       // 已通过（退款已执行）
  rejected       // 已驳回
}

model Refund {
  id             String       @id @default(cuid())
  refundNo       String       @unique            // RF + yyyyMMdd + 4位序列
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketId       String?                          // 来源工单（投诉处置 result=refund 时）
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  amount         Decimal      @db.Decimal(10, 2)  // 申请退款金额（= 订单金额）
  reason         String?      @db.VarChar(200)    // 申请原因（投诉 reason + 期望）
  status         RefundStatus @default(pending_review)
  requestedById  String?                          // 发起人（投诉处置的运营）
  requestedBy    User?        @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  reviewedById   String?                          // 审核人
  reviewedBy     User?        @relation("RefundReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?      @db.VarChar(200)    // 驳回理由 / 审核备注
  refundedAmount Decimal?     @db.Decimal(10, 2)  // 实际退用户金额（阶梯实退）
  settlementId   String?      @unique             // 通过后生成的 compensation 结算单（师傅补偿，1:1）
  settlement     Settlement?  @relation(fields: [settlementId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  deletedAt      DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@index([ticketId])

  @@map("refund")
}

model TicketComment {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  operatorId  String?                                     // 留言人（客服/客户/师傅）
  operator    User?    @relation("TicketCommentOperator", fields: [operatorId], references: [id])
  content     String   @db.Text
  isInternal  Boolean  @default(false)                    // true=内部备注（仅客服可见，不对外）
  visibleTo   String   @default("all")                   // all | customer | master（对外可见范围）
  createdAt   DateTime @default(now())

  deletedAt   DateTime?

  @@index([ticketId])

  @@map("ticketcomment")
}
