# ============================================================
# 老马家电 — 生产环境变量模板
# 复制为 .env.prod 后填写真实值：cp .env.prod.example .env.prod
# docker compose -f docker-compose.prod.yml 会自动读取 .env.prod
# ============================================================

# ─── 数据库 ───────────────────────────────────────────────
# MySQL 连接串。宿主机 MySQL 用 host.docker.internal（compose 已配 extra_hosts）
# 外部 RDS 改为真实地址
DATABASE_URL="mysql://root:你的密码@host.docker.internal:3306/laoma_jiadian?connection_limit=10"

# ─── JWT 认证 ─────────────────────────────────────────────
# 生产必须用强随机值，可用：openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="3600"
JWT_REFRESH_TTL="604800"

# ─── CORS ─────────────────────────────────────────────────
# 逗号分隔白名单。同域（nginx 反代）可不配，留空即可
# 多域名：https://laoma.com,https://www.laoma.com
CORS_ORIGIN=""

# ─── 管理员初始化 ─────────────────────────────────────────
# 容器启动时如检测到此变量，自动创建/更新管理员（幂等）
# 首次部署填入，后续可留空（管理员已存在则跳过）
ADMIN_PASSWORD=""
ADMIN_PHONE="admin"

# ─── 短信加密 ─────────────────────────────────────────────
# 32 字节 hex，用于 AES-256-GCM 加密 AccessKeySecret
# 生成：openssl rand -hex 32
# 换环境必须同步此 key，否则旧密文解不开
SMS_SECRET_ENCRYPT_KEY=""

# ─── 日志 ─────────────────────────────────────────────────
LOG_LEVEL="info"

# ─── 支付（真实联调时配置）──────────────────────────────
PAYMENT_PROVIDER="mock"
WX_MCH_SERIAL=""
WX_NOTIFY_URL=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL=""

# ─── Sentry（可选）────────────────────────────────────────
SENTRY_DSN=""

# ─── 自动派单 ─────────────────────────────────────────────
AUTO_DISPATCH_ENABLED="true"
