{
  "name": "laoma-jiadian",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "prisma:generate": "pnpm --filter @laoma/backend exec prisma generate",
    "prisma:migrate": "pnpm --filter @laoma/backend exec prisma migrate dev",
    "prisma:studio": "pnpm --filter @laoma/backend exec prisma studio",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "husky": "^9",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
